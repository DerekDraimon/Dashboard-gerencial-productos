{
  "name": "dashboard-gerencial-productos",
  "private": true,
  "version": "1.0.0",
  "description": "Product inventory management dashboard (monorepo: backend + frontend).",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run db:up && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:api": "npx --yes newman@6.2.3 run postman/dashboard-gerencial.postman_collection.json -e postman/local.postman_environment.json",
    "seed": "npm run seed -w backend --if-present",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
