# HTTP port of the API
PORT=4000

# MongoDB connection string (docker compose exposes Mongo on localhost:27017)
MONGODB_URI=mongodb://localhost:27017/dashboard

# JWT signing secret and token lifetime
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# JWT lifetime: seconds (3600) or a number followed by s, m, h or d (15m, 12h, 1d)

# Allowed origin for the frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Passwords for the test accounts created by `npm run seed`
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_PASSWORD=User1234!

# Login rate limit: max attempts per IP per window (all attempts count, successful ones too)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
