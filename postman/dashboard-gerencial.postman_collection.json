        {
          "name": "Filter products by creation date",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Window of the last 90 days (UTC) up to today, so it includes the seeded products.",
                  "const day = 24 * 60 * 60 * 1000;",
                  "const today = new Date();",
                  "pm.variables.set('toDate', today.toISOString().slice(0, 10));",
                  "pm.variables.set('fromDate', new Date(today.getTime() - 90 * day).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function expectProduct(product) {",
                  "  pm.expect(product).to.be.an('object');",
                  "  pm.expect(product.id).to.be.a('string').and.match(/^[a-f0-9]{24}$/);",
                  "  pm.expect(product.title).to.be.a('string');",
                  "  pm.expect(product.description).to.be.a('string');",
                  "  pm.expect(product.price).to.be.a('number');",
                  "  pm.expect(product.category).to.be.a('string');",
                  "  pm.expect(product.images).to.be.an('array');",
                  "  pm.expect(product.stock).to.be.a('number');",
                  "  pm.expect(product.creationAt).to.be.a('string');",
                  "  pm.expect(product.updatedAt).to.be.a('string');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body is a page with data and meta', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.meta).to.be.an('object');",
                  "  pm.expect(json.meta.total).to.be.a('number');",
                  "  pm.expect(json.meta.offset).to.be.a('number');",
                  "  pm.expect(json.meta.limit).to.be.a('number');",
                  "  pm.expect(json.data.length).to.be.at.most(json.meta.limit);",
                  "  json.data.forEach(expectProduct);",
                  "});",
                  "pm.test('Every creationAt is inside the from/to window', function () {",
                  "  const from = Date.parse(pm.variables.get('fromDate') + 'T00:00:00.000Z');",
                  "  const to = Date.parse(pm.variables.get('toDate') + 'T23:59:59.999Z');",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.length).to.be.above(0);",
                  "  json.data.forEach((p) => pm.expect(Date.parse(p.creationAt)).to.be.within(from, to));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?from={{fromDate}}&to={{toDate}}&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
