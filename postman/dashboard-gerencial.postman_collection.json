            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function expectUser(user) {",
                  "  pm.expect(user).to.be.an('object');",
                  "  pm.expect(user.id).to.be.a('string').and.match(/^[a-f0-9]{24}$/);",
                  "  pm.expect(user.email).to.be.a('string');",
                  "  pm.expect(user.name).to.be.a('string');",
                  "  pm.expect(user.role).to.be.oneOf(['ADMIN', 'USER']);",
                  "  pm.expect(user.active).to.be.a('boolean');",
                  "  pm.expect(user).to.not.have.property('password');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body is a page with data and meta', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.meta).to.be.an('object');",
                  "  pm.expect(json.meta.total).to.be.a('number');",
                  "  pm.expect(json.meta.offset).to.be.a('number');",
                  "  pm.expect(json.meta.limit).to.be.a('number');",
                  "  pm.expect(json.data.length).to.be.at.most(json.meta.limit);",
                  "  json.data.forEach(expectUser);",
                  "});",
                  "pm.test('Every user is active', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.length).to.be.above(0);",
                  "  json.data.forEach((u) => pm.expect(u.active).to.eql(true));",
                  "});"
                ]
              }
            }
