{
  "info": {
    "_postman_id": "6b1f3c2e-8d4a-4e7b-9f10-2a5c7d9e1b34",
    "name": "Dashboard gerencial de productos",
    "description": "Requests and response checks for the Dashboard gerencial de productos API. Run it in order with the \"Local\" environment: it logs in, exercises products and users, deletes the product it creates and leaves the user it creates inactive.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('API and database are up', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json.database).to.eql('connected');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Login as ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body has a token and the ADMIN user', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.role).to.eql('ADMIN');",
                  "  pm.expect(json.user.active).to.eql(true);",
                  "  pm.expect(json.user).to.not.have.property('password');",
                  "  pm.environment.set('adminToken', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login as USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Body has a token and the USER user', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.user).to.be.an('object');",
                  "  pm.expect(json.user.role).to.eql('USER');",
                  "  pm.expect(json.user.active).to.eql(true);",
                  "  pm.expect(json.user).to.not.have.property('password');",
                  "  pm.environment.set('userToken', json.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login with wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Error body has code INVALID_CREDENTIALS and a message', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('error').that.is.an('object');",
                  "  pm.expect(json.error.code).to.eql('INVALID_CREDENTIALS');",
                  "  pm.expect(json.error.message).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('No token is returned', function () {",
                  "  pm.expect(pm.response.json()).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function expectUser(user) {",
                  "  pm.expect(user).to.be.an('object');",
                  "  pm.expect(user.id).to.be.a('string').and.match(/^[a-f0-9]{24}$/);",
                  "  pm.expect(user.email).to.be.a('string');",
                  "  pm.expect(user.name).to.be.a('string');",
                  "  pm.expect(user.role).to.be.oneOf(['ADMIN', 'USER']);",
                  "  pm.expect(user.active).to.be.a('boolean');",
                  "  pm.expect(user).to.not.have.property('password');",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Current user is the ADMIN', function () {",
                  "  const json = pm.response.json();",
                  "  expectUser(json);",
                  "  pm.expect(json.role).to.eql('ADMIN');",
                  "  pm.expect(json.email).to.eql(pm.environment.get('adminEmail').toLowerCase());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  }
}
